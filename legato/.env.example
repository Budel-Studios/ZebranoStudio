# ─── Contact form — e-mail ────────────────────────────────────────────────────
# Copy to `.env.local` (local) or set the values in the hosting environment.
# `.env.local` is never committed. Without these values the form shows a
# friendly error instead of pretending the message was sent.

# Where requests are delivered (required).
CONTACT_TO_EMAIL=

# Preferred: Resend. MAIL_FROM must belong to a domain verified in Resend.
RESEND_API_KEY=
MAIL_FROM=

# ─── Alternative: SMTP (only used when RESEND_API_KEY is empty) ──────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Production URL, e.g. https://www.example.com
NEXT_PUBLIC_SITE_URL=

# ─── Studio — Claude as book designer ────────────────────────────────────────
# Server-side only. With a key, Claude designs the book and helps with texts;
# without one the studio falls back to its built-in layout rules.
ANTHROPIC_API_KEY=
# Optional shared code the studio must send with every AI request. Set it on any
# public deployment, and set a spend limit on the key in the Anthropic console.
STUDIO_ACCESS_CODE=
