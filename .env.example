# ─── Formulieren — e-mail ─────────────────────────────────────────────────────
# Kopieer naar `.env.local` (lokaal) of zet de waarden in Vercel → Settings →
# Environment Variables. `.env.local` wordt NOOIT gecommit.
#
# Aanvragen gaan voorlopig naar de mailbox van MTB Bouw (info@mtbbouw.com),
# net als bij De Kozijnstudio.

# Aanbevolen: dezelfde Resend-sleutel als op de MTB Bouw-site.
RESEND_API_KEY=
# Afzender (moet bij een in Resend geverifieerd domein horen)
MAIL_FROM=website@mtbbouw.com

# Optioneel: ander ontvangstadres dan info@mtbbouw.com
OFFERTE_TO_EMAIL=

# ─── Alternatief: SMTP (alleen gebruikt als RESEND_API_KEY leeg is) ──────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
OFFERTE_FROM_EMAIL=

# Productie-URL (Vercel). Standaard https://www.zebranostudio.com
NEXT_PUBLIC_SITE_URL=
